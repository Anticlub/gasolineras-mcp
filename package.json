{
  "name": "gasolineras-mcp",
  "version": "1.0.0",
  "description": "Servidor MCP que conecta un agente de IA con la API oficial de precios de carburantes de España (11.000+ estaciones).",
  "type": "module",
  "bin": {
    "gasolineras-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "start": "node dist/index.js",
    "dev": "bun run src/index.ts",
    "smoke": "bun run src/smoke.ts",
    "test:client": "bun run test-client.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "typescript",
    "carburantes",
    "claude"
  ],
  "author": "Cristofer Fernández",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
